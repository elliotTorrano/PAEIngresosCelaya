/* Estilo base del Sistema PAE. El Administrador puede añadir color/imagen de fondo
   adicionales desde la pestaña "Apariencia", que se agregan a continuación de esto.
   Nota: esta hoja se aplica al centralWidget de cada ventana, nunca a la QMainWindow
   directamente -- ver apply_window_background() en app/ui/widgets/styles.py. */

QTabWidget::pane {
    background-color: rgba(255, 255, 255, 0.88);
    border: 1px solid #c9d2da;
}

QTabBar::tab {
    background-color: rgba(255, 255, 255, 0.80);
    padding: 6px 14px;
    border: 1px solid #c9d2da;
    border-bottom: none;
}

QTabBar::tab:selected {
    background-color: rgba(255, 255, 255, 0.97);
    font-weight: 600;
}

QGroupBox {
    background-color: rgba(255, 255, 255, 0.88);
    border: 1px solid #c9d2da;
    border-radius: 6px;
    margin-top: 12px;
    padding: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
}

QPushButton {
    padding: 6px 12px;
    border-radius: 4px;
    border: 1px solid #94a3b8;
    background-color: #ffffff;
}

QPushButton:hover {
    background-color: #e2e8f0;
}

QTableWidget {
    gridline-color: #cbd5e1;
}

QHeaderView::section {
    background-color: #1f3a5f;
    color: white;
    padding: 4px;
}
